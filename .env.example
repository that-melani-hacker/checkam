# Copy to .env.local (never commit .env.local). Add the same keys in Vercel > Settings > Environment Variables.
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.8-flash
# Optional: when set, Claude reads the pack instead of Gemini (console.anthropic.com)
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MODE=false
